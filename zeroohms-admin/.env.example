# URL del backend FastAPI (server.mjs la proxea bajo /api en producción)
BACKEND_URL=http://localhost:3001

# Puerto del server.mjs (opcional, default 5176)
PORT=5176

# URL pública de zeroohms-frontend (el sitio público, NO este admin). Se usa
# en build time para armar el link del QR de "subir fotos", que vive en
# /subir-fotos del sitio público. Sin esta variable, el QR apunta al propio
# dominio del admin y el celular termina pidiendo login en vez de mostrar el
# formulario de subida. Pasarla como build arg al Dockerfile en producción.
VITE_PUBLIC_SITE_URL=https://zeroohms.com.ar
